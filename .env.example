# Copy to .env and fill in. Nothing here is required to run — without a key,
# narration falls back to quoting Wikipedia verbatim.

# Lets Claude write the one-line hooks instead of quoting them. Every generated
# line is checked back against its source and dropped if it contains a name,
# number or date the source does not support.
ANTHROPIC_API_KEY=

# Optional overrides.
# FOOTLORE_MODEL=claude-sonnet-5
# FOOTLORE_CACHE=./.cache
# PORT=4173
